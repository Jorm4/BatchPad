<UserControl x:Class="BatchPad.App.Views.Workspace.NewItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Location, StringFormat=In {0}}" Opacity="0.7" Margin="0,2,0,12" />
        <TextBlock Text="Name" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"
                 AutomationProperties.AutomationId="NewItemName" AutomationProperties.Name="Name" />
        <StackPanel Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding TargetLabel}" TextWrapping="Wrap" />
            <DockPanel Margin="0,4,0,10">
                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="6,0,0,0"
                        AutomationProperties.AutomationId="NewItemBrowse" />
                <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="NewItemTarget" AutomationProperties.Name="Target" />
            </DockPanel>
            <TextBlock Text="Description" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"
                     AutomationProperties.AutomationId="NewItemDescription" AutomationProperties.Name="Description" />
        </StackPanel>
        <TextBlock Text="{Binding Error}" Foreground="#C42B1C" TextWrapping="Wrap" AutomationProperties.AutomationId="NewItemError" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Add" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="80"
                    AutomationProperties.AutomationId="NewItemSaveButton" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="6,0,0,0"
                    AutomationProperties.AutomationId="NewItemCancelButton" />
        </StackPanel>
    </StackPanel>
</UserControl>
