<UserControl x:Class="BatchPad.App.Views.Editor.AfterRunTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BatchPad.App.ViewModels.Editor"
             xmlns:views="clr-namespace:BatchPad.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,6,16,8" />
                </Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </Grid.Resources>

            <TextBlock Text="Ready when a line matches" />
            <TextBox Grid.Column="1" Text="{Binding ReadyPattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                     ToolTip="A regular expression; for example Serving on (http://\S+)"
                     AutomationProperties.AutomationId="ReadyPattern" AutomationProperties.Name="Ready pattern" />
            <TextBlock Grid.Row="1" Text="Then open" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OpenUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                     ToolTip="A URL or file; $1 is the pattern's first group, ${param:port} a parameter"
                     AutomationProperties.AutomationId="ReadyOpenUrl" AutomationProperties.Name="Open URL" />
            <TextBlock Grid.Row="2" Text="Stop with" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StopChoices}" SelectedItem="{Binding Stop}" DisplayMemberPath="Label"
                      HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,8"
                      AutomationProperties.AutomationId="StopCompanion" AutomationProperties.Name="Stop companion" />
            <TextBlock Grid.Row="3" Text="Test report" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TestReport, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="JUnit XML the script writes, for example build/qa/junit.xml"
                     AutomationProperties.AutomationId="TestReportPath" AutomationProperties.Name="Test report" />
            <TextBlock Grid.Row="4" Text="Artifacts" />
            <StackPanel Grid.Row="4" Grid.Column="1">
                <views:FlatItemsControl ItemsSource="{Binding Artifacts}" AutomationProperties.AutomationId="ArtifactRows">
                    <views:FlatItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ArtifactRowViewModel}">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Remove" Margin="6,0,0,0"
                                        Command="{Binding DataContext.RemoveArtifactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.AutomationId="RemoveArtifact" />
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding DataContext.OpenOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Open}" DisplayMemberPath="Label" Margin="6,0,0,0" MinWidth="140"
                                          AutomationProperties.AutomationId="ArtifactOpen" AutomationProperties.Name="When to open" />
                                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                         AutomationProperties.AutomationId="ArtifactPath" AutomationProperties.Name="Artifact path" />
                            </DockPanel>
                        </DataTemplate>
                    </views:FlatItemsControl.ItemTemplate>
                </views:FlatItemsControl>
                <Button Content="+ Add artifact" Command="{Binding AddArtifactCommand}" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AddArtifact" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
