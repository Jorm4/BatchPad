<UserControl x:Class="BatchPad.App.Views.Editor.AfterRunTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BatchPad.App.ViewModels.Editor"
             xmlns:views="clr-namespace:BatchPad.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Margin" Value="0,6,16,8" />
                </Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </Grid.Resources>

            <TextBlock Text="Ready when a line matches" />
            <TextBox Grid.Column="1" Text="{Binding ReadyPattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                     ToolTip="A regular expression; for example Serving on (http://\S+)"
                     AutomationProperties.AutomationId="ReadyPattern" AutomationProperties.Name="Ready pattern" />
            <TextBlock Grid.Row="1" Text="Then open" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OpenUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                     ToolTip="A URL or file; $1 is the pattern's first group, ${param:port} a parameter"
                     AutomationProperties.AutomationId="ReadyOpenUrl" AutomationProperties.Name="Open URL" />
            <TextBlock Grid.Row="2" Text="Test the pattern" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Use last run's output" Command="{Binding UseLastOutputCommand}" Margin="6,0,0,0"
                            VerticalAlignment="Top" AutomationProperties.AutomationId="UseLastOutput" />
                    <TextBox Text="{Binding SampleOutput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60" MaxHeight="160"
                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" Margin="0"
                             AutomationProperties.AutomationId="ReadySample" AutomationProperties.Name="Sample output" />
                </DockPanel>
                <TextBlock Text="{Binding TesterResult}" Margin="0,4,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="ReadyTesterResult" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="Error lines" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ErrorPatterns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                     MinHeight="48" FontFamily="{StaticResource MonoFont}"
                     ToolTip="One regular expression per line; matching output lines are marked, for example LNK\d{4}"
                     AutomationProperties.AutomationId="ErrorPatterns" AutomationProperties.Name="Error patterns" />
            <TextBlock Grid.Row="4" Text="Stop with" />
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding StopChoices}" SelectedItem="{Binding Stop}" DisplayMemberPath="Label"
                      HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,8"
                      AutomationProperties.AutomationId="StopCompanion" AutomationProperties.Name="Stop companion" />
            <TextBlock Grid.Row="5" Text="Test report" />
            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                <TextBox Text="{Binding TestReport, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                         ToolTip="JUnit XML the script writes, for example build/qa/junit.xml"
                         AutomationProperties.AutomationId="TestReportPath" AutomationProperties.Name="Test report" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Re-run failed fills" Margin="0,6,8,0" />
                    <ComboBox ItemsSource="{Binding RerunParamChoices}" SelectedItem="{Binding RerunParam}" DisplayMemberPath="Label" MinWidth="200"
                              AutomationProperties.AutomationId="RerunParam" AutomationProperties.Name="Re-run parameter" />
                    <TextBlock Text="with" Margin="8,6,8,0" />
                    <ComboBox ItemsSource="{Binding RerunByChoices}" SelectedItem="{Binding RerunScope}" DisplayMemberPath="Label" MinWidth="160"
                              AutomationProperties.AutomationId="RerunBy" AutomationProperties.Name="Re-run by" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="6" Text="Benchmark report" />
            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                <TextBox DockPanel.Dock="Right" Text="{Binding BenchmarkThresholdPercent, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0"
                         ToolTip="Percent change that counts as slower or faster; empty for 5"
                         AutomationProperties.AutomationId="BenchmarkThreshold" AutomationProperties.Name="Benchmark threshold" />
                <TextBlock DockPanel.Dock="Right" Text="threshold %" Margin="12,6,8,0" />
                <TextBox Text="{Binding BenchmarkReport, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                         ToolTip="Google Benchmark JSON the script writes with --benchmark_out, for example build/bench.json"
                         AutomationProperties.AutomationId="BenchmarkReportPath" AutomationProperties.Name="Benchmark report" />
            </DockPanel>
            <TextBlock Grid.Row="7" Text="Artifacts" />
            <StackPanel Grid.Row="7" Grid.Column="1">
                <views:FlatItemsControl ItemsSource="{Binding Artifacts}" AutomationProperties.AutomationId="ArtifactRows">
                    <views:FlatItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ArtifactRowViewModel}">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Remove" Margin="6,0,0,0"
                                        Command="{Binding DataContext.RemoveArtifactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.AutomationId="RemoveArtifact" />
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding DataContext.OpenOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Open}" DisplayMemberPath="Label" Margin="6,0,0,0" MinWidth="140"
                                          AutomationProperties.AutomationId="ArtifactOpen" AutomationProperties.Name="When to open" />
                                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                         AutomationProperties.AutomationId="ArtifactPath" AutomationProperties.Name="Artifact path" />
                            </DockPanel>
                        </DataTemplate>
                    </views:FlatItemsControl.ItemTemplate>
                </views:FlatItemsControl>
                <Button Content="+ Add artifact" Command="{Binding AddArtifactCommand}" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AddArtifact" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
