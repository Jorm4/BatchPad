<UserControl x:Class="BatchPad.App.Views.BenchmarkPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BatchPad.App.ViewModels"
             xmlns:views="clr-namespace:BatchPad.App.Views">
    <DockPanel Background="{StaticResource OutputBackgroundBrush}">
        <DockPanel DockPanel.Dock="Top" Margin="8,4">
            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Baselines}" SelectedItem="{Binding Baseline}" DisplayMemberPath="Label" MinWidth="200"
                      ToolTip="Compare with another earlier run of this script"
                      AutomationProperties.AutomationId="BenchmarkBaseline" AutomationProperties.Name="Compare with" />
            <TextBlock DockPanel.Dock="Right" Text="Compare with…" Foreground="{StaticResource OutputMutedBrush}" VerticalAlignment="Center" Margin="16,0,6,0" />
            <TextBlock Text="{Binding Header}" Foreground="{StaticResource OutputTextBrush}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="BenchmarkHeader" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
            <StackPanel Margin="8,0,8,8" TextElement.FontFamily="{StaticResource MonoFont}" TextElement.FontSize="{views:ScaledSize 12}">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Name" />
                        <ColumnDefinition SharedSizeGroup="Time" />
                        <ColumnDefinition SharedSizeGroup="Baseline" />
                        <ColumnDefinition SharedSizeGroup="Change" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Benchmark" Foreground="{StaticResource OutputMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="Time" Foreground="{StaticResource OutputMutedBrush}" Margin="24,0,0,0" TextAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="Baseline" Foreground="{StaticResource OutputMutedBrush}" Margin="24,0,0,0" TextAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="Change" Foreground="{StaticResource OutputMutedBrush}" Margin="24,0,0,0" TextAlignment="Right" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.AutomationId="BenchmarkRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BenchmarkRowViewModel}">
                            <Grid AutomationProperties.Name="{Binding Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="Name" />
                                    <ColumnDefinition SharedSizeGroup="Time" />
                                    <ColumnDefinition SharedSizeGroup="Baseline" />
                                    <ColumnDefinition SharedSizeGroup="Change" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource OutputTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource OutputTextBrush}" Margin="24,0,0,0" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding BaselineText}" Foreground="{StaticResource OutputMutedBrush}" Margin="24,0,0,0" TextAlignment="Right" />
                                <TextBlock x:Name="Change" Grid.Column="3" Text="{Binding ChangeText}" Foreground="{StaticResource OutputTextBrush}" Margin="24,0,0,0"
                                           TextAlignment="Right" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Verdict}" Value="Slower">
                                    <Setter TargetName="Change" Property="Foreground" Value="{StaticResource OutputErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Verdict}" Value="Faster">
                                    <Setter TargetName="Change" Property="Foreground" Value="{StaticResource OutputSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Verdict}" Value="New">
                                    <Setter TargetName="Change" Property="Foreground" Value="{StaticResource OutputMutedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Verdict}" Value="Gone">
                                    <Setter TargetName="Change" Property="Foreground" Value="{StaticResource OutputMutedBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
