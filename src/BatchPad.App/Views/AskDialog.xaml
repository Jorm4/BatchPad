<Window x:Class="BatchPad.App.Views.AskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BatchPad.App.Views"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=Form}"
        AutomationProperties.AutomationId="AskDialog">
    <StackPanel Margin="16">
        <views:ParameterForm x:Name="Form" />
        <TextBlock Text="{Binding ErrorSummary}" Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Run" IsDefault="True" MinWidth="80" Click="OnRun" AutomationProperties.AutomationId="AskRun" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="8,0,0,0" AutomationProperties.AutomationId="AskCancel" />
        </StackPanel>
    </StackPanel>
</Window>
