<UserControl x:Class="BatchPad.App.Views.ParameterForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:BatchPad.App.ViewModels.Parameters"
             xmlns:views="clr-namespace:BatchPad.App.Views">
    <UserControl.Resources>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Text" Value="{Binding Error}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type p:FlagFieldViewModel}">
            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Description}"
                      AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type p:TextFieldViewModel}">
            <StackPanel>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
                <TextBlock Style="{StaticResource FieldError}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type p:SecretFieldViewModel}">
            <PasswordBox views:PasswordBinding.Password="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type p:IntFieldViewModel}">
            <StackPanel>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left"
                         AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
                <TextBlock Style="{StaticResource FieldError}" AutomationProperties.AutomationId="FieldError" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type p:PathFieldViewModel}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Command="{Binding BrowseCommand}"
                        AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Browse}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type p:ChoiceFieldViewModel}">
            <StackPanel>
                <ListBox x:Name="Segments" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                         DisplayMemberPath="Label" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"
                         AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="Padding" Value="12,4" />
                            <Setter Property="Margin" Value="0,0,2,0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <ComboBox x:Name="Combo" Visibility="Collapsed" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                          DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                          Width="260" HorizontalAlignment="Left"
                          AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}" />
                <TextBlock Text="{Binding Problems}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSegmented}" Value="False">
                    <Setter TargetName="Segments" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Combo" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type p:MultichoiceFieldViewModel}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding ClearLabel}" Command="{Binding ClearCommand}" Margin="6,0,0,0"
                            AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Clear}" />
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"
                             AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Filter}"
                             AutomationProperties.Name="Filter" />
                </DockPanel>
                <views:FlatItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0" MaxHeight="160"
                              AutomationProperties.AutomationId="{Binding AutomationId}">
                    <views:FlatItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </views:FlatItemsControl.Template>
                    <views:FlatItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type p:MultichoiceItem}">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </views:FlatItemsControl.ItemTemplate>
                </views:FlatItemsControl>
                <TextBlock Text="{Binding Summary, StringFormat=Selected: {0}}" Opacity="0.7"
                           AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}_Summary}" />
                <TextBlock Text="{Binding Problems}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Grid.IsSharedSizeScope="True">
        <views:FlatItemsControl ItemsSource="{Binding Fields}" Focusable="False">
            <views:FlatItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Margin="0,6,16,0" MinWidth="80" ToolTip="{Binding Description}" />
                        <ContentControl Grid.Column="1" Content="{Binding}" Focusable="False" />
                    </Grid>
                </DataTemplate>
            </views:FlatItemsControl.ItemTemplate>
        </views:FlatItemsControl>
        <Grid Visibility="{Binding HasExtraArguments, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Extra" Margin="0,6,16,0" MinWidth="80" ToolTip="Extra arguments, appended to the command" />
            <TextBox Grid.Column="1" Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="ExtraArguments" AutomationProperties.Name="Extra arguments" />
        </Grid>
    </StackPanel>
</UserControl>
