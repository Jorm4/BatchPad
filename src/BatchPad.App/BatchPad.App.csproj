<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BatchPad</AssemblyName>
    <RootNamespace>BatchPad.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>BatchPad.ico</ApplicationIcon>
    <StartupObject>BatchPad.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="ModelContextProtocol" />
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Templates\**" />
    <EmbeddedResource Include="Templates\new.*" LogicalName="BatchPad.App.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatchPad.Core\BatchPad.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="BatchPad.ico" />
    <EmbeddedResource Include="BatchPad.ico" LogicalName="BatchPad.App.BatchPad.ico" />
  </ItemGroup>

</Project>
