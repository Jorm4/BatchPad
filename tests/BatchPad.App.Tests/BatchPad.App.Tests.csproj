<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="BatchPad.Tests" />
    <Using Include="BatchPad.Tests.TestHelpers" Static="true" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BatchPad.App\BatchPad.App.csproj" />
    <ProjectReference Include="..\..\src\BatchPad.Shim\BatchPad.Shim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\**\*" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\adoption\**\*" LinkBase="fixtures\adoption" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\junit\**\*" LinkBase="fixtures\junit" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\config\**\*" LinkBase="fixtures\config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\cli\**\*" LinkBase="fixtures\cli" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\run\exit3.bat" Link="fixtures\run\exit3.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyComShim" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)BatchPad.Shim.exe" DestinationFiles="$(OutDir)batchpad.com" SkipUnchangedFiles="true" />
  </Target>

</Project>
